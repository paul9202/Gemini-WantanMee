{
  "name": "hao-wantan-mee-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run functions:typecheck && npm run test:functions-unit && npm run build",
    "functions:build": "npm --prefix functions run build",
    "functions:typecheck": "npm --prefix functions run typecheck",
    "emulators": "npm run functions:build && firebase emulators:start --project demo-hao-wantan",
    "test:rules": "firebase emulators:exec --project demo-hao-wantan --only firestore,storage \"npm --prefix functions run test:rules\"",
    "test:emulator": "npm run functions:build && firebase emulators:exec --project demo-hao-wantan --only auth,firestore,functions,storage \"npm --prefix functions run test:commands\"",
    "emulators:seed": "npm --prefix functions run seed",
    "photos": "node scripts/build-photos.mjs",
    "test:functions-unit": "npm --prefix functions run test:unit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "fake-indexeddb": "^6.2.6",
    "firebase-tools": "^15.34.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
