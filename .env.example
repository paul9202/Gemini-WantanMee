# Firebase Web 应用配置（公开配置，不是数据库授权；授权由 Auth + Rules + Functions 决定）。
# 本地 Emulator 使用 demo- 项目，无需真实值。
VITE_FIREBASE_PROJECT_ID="demo-hao-wantan"
VITE_FIREBASE_API_KEY="demo-api-key"
VITE_FIREBASE_AUTH_DOMAIN="demo-hao-wantan.firebaseapp.com"
VITE_FIREBASE_APP_ID="demo-app-id"
# Functions 区域：必须与 functions/src/index.ts 中的 REGION 一致。
VITE_FUNCTIONS_REGION="asia-southeast1"
# 门店 ID（单店首版）。
VITE_STORE_ID="hao-pontian-main"
# true 时前端连接本地 Emulator。生产构建必须为 false。
VITE_USE_EMULATORS="true"

# 禁止在此文件或仓库中存放服务账号私钥 JSON。
